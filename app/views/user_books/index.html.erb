<% content_for :title, "User Books" %>

<h1>User Books</h1>

<p>
  <%= link_to "Books", books_path %>
  <%= link_to "Users", users_path %>
  <%= link_to "New user book", new_user_book_path %>
</p>

<table>
  <thead>
    <tr>
      <th>User</th>
      <th>Book</th>
      <th colspan="3">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @user_books.each do |user_book| %>
      <tr>
        <td><%= user_book.user.username %></td>
        <td><%= user_book.book.title %></td>
        <td><%= link_to "Show", user_book_path(user_book) %></td>
        <td><%= link_to "Update", edit_user_book_path(user_book) %></td>
        <td><%= link_to "Delete", delete_user_book_path(user_book) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
