<% content_for :title, "Users" %>

<h1>Users</h1>

<p><%= link_to "New User", new_user_path %></p>

<table>
  <thead>
    <tr>
      <th>Username</th>
      <th colspan="3">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.username %></td>
        <td><%= link_to "Show", user_path(user) %></td>
        <td><%= link_to "Update", edit_user_path(user) %></td>
        <td><%= link_to "Delete", delete_user_path(user) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
