<% content_for :title, "Show Book" %>

<h1>Show</h1>

<p>
  <strong>Title:</strong>
  <%= @book.title %>
</p>
<p>
  <strong>Author:</strong>
  <%= @book.author %>
</p>
<p>
  <strong>Price:</strong>
  <%= number_to_currency(@book.price) if @book.price %>
</p>
<p>
  <strong>Published date:</strong>
  <%= @book.published_date %>
</p>

<p>
  <%= link_to "Update", edit_book_path(@book) %>
  <%= link_to "Delete", delete_book_path(@book) %>
  <%= link_to "Back to Home", books_path %>
</p>
