<% content_for :title, "Home" %>

<h1>Home</h1>

<p><%= link_to "Add a Book", new_book_path %></p>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Author</th>
      <th>Price</th>
      <th>Published date</th>
      <th colspan="3">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @books.each do |book| %>
      <tr>
        <td><%= book.title %></td>
        <td><%= book.author %></td>
        <td><%= number_to_currency(book.price) if book.price %></td>
        <td><%= book.published_date %></td>
        <td><%= link_to "Show", book_path(book) %></td>
        <td><%= link_to "Update", edit_book_path(book) %></td>
        <td><%= link_to "Delete", delete_book_path(book) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
